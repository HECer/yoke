{
  "name": "@hecer/yoke",
  "version": "1.5.0",
  "description": "One harness, three agents, zero trust in \"done\" — cross-agent coding harness for Claude Code, Codex CLI, and Gemini CLI: one skill canon, mechanical safety gates, an autonomous loop with screenshot/video proofs.",
  "type": "module",
  "bin": {
    "yoke": "dist/cli.js"
  },
  "files": [
    "dist",
    "canon",
    ".claude-plugin",
    ".codex-plugin",
    "gemini-extension.json",
    "agents",
    "hooks",
    "bench/README.md",
    "bench/output-compaction.mjs",
    "bench/RESULTS.md",
    "bench/result-schema.mjs",
    "bench/run.mjs",
    "bench/run-large.mjs",
    "bench/run-matrix.mjs",
    "bench/analyze-routing-study.mjs",
    "bench/fixtures",
    "bench/results",
    "docs",
    "CHANGELOG.md",
    "TODOS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HECer/yoke.git"
  },
  "homepage": "https://github.com/HECer/yoke#readme",
  "bugs": {
    "url": "https://github.com/HECer/yoke/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "gemini-cli",
    "agents",
    "agentic-coding",
    "harness",
    "autonomous",
    "ralph-loop",
    "code-review",
    "skills",
    "agents-md",
    "tdd",
    "claude-plugin",
    "claude-code-plugin",
    "gemini-cli-extension"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "docs:check": "node scripts/release-metadata.mjs --check",
    "docs:update": "node scripts/release-metadata.mjs --write",
    "audit:ci": "npm audit --audit-level=high",
    "package:check": "npm pack --dry-run",
    "yoke": "tsx src/cli.ts",
    "prepublishOnly": "npm run lint && npm run build && vitest run && npm run docs:check && npm run package:check"
  },
  "dependencies": {
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "smol-toml": "^1.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
